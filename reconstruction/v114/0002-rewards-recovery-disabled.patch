+/* Reconstruction only; deliberately hard-disabled until source build and
+ * outcome/item provenance parity. No save field, no additional heap. */
+#define SG_RECONSTRUCTION_RECOVERY_ENABLED FALSE
+
+static bool32 SGReconstructionCanRecoverParty(void)
+{
+    // Ordinary owned parties only. Unknown/special battle modes fail closed.
+    const u32 allowed = BATTLE_TYPE_IS_MASTER | BATTLE_TYPE_TRAINER
+                      | BATTLE_TYPE_DOUBLE | BATTLE_TYPE_TWO_OPPONENTS
+                      | BATTLE_TYPE_ROAMER | BATTLE_TYPE_LEGENDARY;
+
+    if (!SG_RECONSTRUCTION_RECOVERY_ENABLED
+        || !(gBattleTypeFlags & BATTLE_TYPE_IS_MASTER)
+        || (gBattleTypeFlags & ~allowed)
+        || IsNPCFollowerWildBattle() || gTestRunnerEnabled)
+        return FALSE;
+
+    // Exact outcome allowlist, never loss, draw, forfeit or link outcome.
+    switch (gBattleOutcome)
+    {
+    case B_OUTCOME_WON:
+    case B_OUTCOME_RAN:
+    case B_OUTCOME_PLAYER_TELEPORTED:
+    case B_OUTCOME_MON_FLED:
+    case B_OUTCOME_CAUGHT:
+        return TRUE;
+    default:
+        return FALSE;
+    }
+}
+
+static void SGReconstructionRestoreConsumedItems(void)
+{
+    if (!SGReconstructionCanRecoverParty() || gBattleStruct == NULL)
+        return;
+
+    // Reuse the engine's original-item and consumed-item ledgers while live.
+    // Only restore a matching originally held item into an empty slot.
+    // Leave theft, exchanged items, replacement/PC transfer and occupied
+    // slots to the existing native behavior until their provenance is proven.
+    for (u32 i = 0; i < PARTY_SIZE; i++)
+    {
+        struct Pokemon *mon = &gPlayerParty[i];
+        u32 species = GetMonData(mon, MON_DATA_SPECIES_OR_EGG);
+        if (species == SPECIES_NONE || species == SPECIES_EGG)
+            continue;
+        for (u32 j = 0; j < MAX_MON_ITEMS; j++)
+        {
+            u16 original = gBattleStruct->itemLost[B_SIDE_PLAYER][i][j].originalItem;
+            u16 consumed = gBattleStruct->partyState[B_SIDE_PLAYER][i].consumedHeldItems[j];
+            if (original != ITEM_NONE && consumed == original
+                && !gBattleStruct->itemLost[B_SIDE_PLAYER][i][j].stolen
+                && GetMonData(mon, MON_DATA_HELD_ITEM + j) == ITEM_NONE)
+                SetMonData(mon, MON_DATA_HELD_ITEM + j, &original);
+        }
+    }
+}
