diff --git a/test/bag.c b/test/bag.c
--- a/test/bag.c
+++ b/test/bag.c
@@ -8,7 +8,41 @@
 #include "test/overworld_script.h"
 #include "test/test.h"
 
-TEST("Items are stored in their correct bag pockets")
+#if SG_RECONSTRUCTION_LARGE_BAG
+TEST("Large bag stack retains native quantity encoding and one-ball debit")
+{
+    struct BagPocket *pocket = &gBagPockets[POCKET_POKE_BALLS];
+    for (u32 i = 0; i < pocket->capacity; i++)
+        BagPocket_SetSlotItemIdAndCount(pocket, i, ITEM_NONE, 0);
+    EXPECT(AddBagItem(ITEM_MOON_BALL, 9999));
+    EXPECT_EQ(BagPocket_GetSlotData(pocket, 0).quantity, 9999);
+    EXPECT_EQ(CountTotalItemQuantityInBag(ITEM_MOON_BALL), 9999);
+    EXPECT(RemoveBagItem(ITEM_MOON_BALL, 1));
+    EXPECT_EQ(CountTotalItemQuantityInBag(ITEM_MOON_BALL), 9998);
+}
+
+TEST("Large bag removal debits only the requested amount across stacks")
+{
+    struct BagPocket *pocket = &gBagPockets[POCKET_POKE_BALLS];
+    for (u32 i = 0; i < pocket->capacity; i++)
+        BagPocket_SetSlotItemIdAndCount(pocket, i, ITEM_NONE, 0);
+    EXPECT(AddBagItem(ITEM_MOON_BALL, 10001));
+    EXPECT(RemoveBagItem(ITEM_MOON_BALL, 10000));
+    EXPECT_EQ(CountTotalItemQuantityInBag(ITEM_MOON_BALL), 1);
+    EXPECT(!RemoveBagItem(ITEM_MOON_BALL, 2));
+    EXPECT_EQ(CountTotalItemQuantityInBag(ITEM_MOON_BALL), 1);
+}
+
+TEST("Large bag keeps item PC stack capacity at 999")
+{
+    memset(gSaveBlock1Ptr->pcItems, 0, sizeof(gSaveBlock1Ptr->pcItems));
+    EXPECT(AddPCItem(ITEM_MOON_BALL, 1000));
+    EXPECT_EQ(gSaveBlock1Ptr->pcItems[0].quantity, 999);
+    EXPECT_EQ(gSaveBlock1Ptr->pcItems[1].quantity, 1);
+}
+#endif
+
+TEST("Items are stored in their correct bag pockets")
 {
