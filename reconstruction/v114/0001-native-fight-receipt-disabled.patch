+
+bool32 SGReconstructionCheckFight(enum BattlerId battler)
+{
+    u32 mask;
+    bool32 allUnusable = CheckFightAndSetNoMoves(battler, &mask);
+    if (battler == 0)
+    {
+        if (SG_RECONSTRUCTION_AUTO_ENABLED && !allUnusable
+            && (mask & ~ALL_MOVES_MASK) == 0
+            && sSGReconstructionReceipt.phase == SG_RECEIPT_FIGHT
+            && SGReconstructionSameContext(battler))
+        {
+            sSGReconstructionReceipt.unusableMask = mask;
+            sSGReconstructionReceipt.phase = SG_RECEIPT_MASK;
+        }
+        else
+            SGReconstructionResetReceipt(battler);
+    }
+    return allUnusable;
+}
+
+void SGReconstructionRecordMoveRequest(enum BattlerId battler)
+{
+    if (battler != 0)
+        return;
+    if (!SG_RECONSTRUCTION_AUTO_ENABLED
+        || sSGReconstructionReceipt.phase != SG_RECEIPT_MASK
+        || !SGReconstructionSameContext(battler)
+        || gBattleResources->bufferA[battler][0] != CONTROLLER_CHOOSEMOVE
+        || sizeof(sSGReconstructionReceipt.payload) > sizeof(gBattleResources->bufferA[battler]))
+    {
+        SGReconstructionResetReceipt(battler);
+        return;
+    }
+    memcpy(sSGReconstructionReceipt.payload, gBattleResources->bufferA[battler],
+           sizeof(sSGReconstructionReceipt.payload));
+    sSGReconstructionReceipt.phase = SG_RECEIPT_REQUEST;
+    /* No receipt consumer, lease, scorer or move emitter is enabled yet. */
+}
