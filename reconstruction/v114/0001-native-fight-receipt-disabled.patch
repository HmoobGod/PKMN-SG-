+} sSGReconstructionReceipt = {0};
+
+void SGReconstructionResetReceipt(enum BattlerId battler)
+{
+    if (battler == 0)
+        memset(&sSGReconstructionReceipt, 0, sizeof(sSGReconstructionReceipt));
+}
+
+/* Until the exact caught-shiny registry and save toggle are reconstructed,
+ * deny ALL shiny foes. The normal player menu remains available. */
+static bool32 SGReconstructionScope(enum BattlerId battler)
+{
+    if (battler != 0 || gBattleResources == NULL || gBattlersCount != 2
+        || gBattleTypeFlags != BATTLE_TYPE_IS_MASTER || gAbsentBattlerFlags != 0
+        || GetBattlerAtPosition(B_POSITION_PLAYER_LEFT) != 0
+        || GetBattlerAtPosition(B_POSITION_OPPONENT_LEFT) != 1
+        || gBattlerPartyIndexes[0] >= PARTY_SIZE || gBattlerPartyIndexes[1] >= PARTY_SIZE
+        || !IsBattlerAlive(0) || !IsBattlerAlive(1))
+        return FALSE;
+    return !IsMonShiny(&gEnemyParty[gBattlerPartyIndexes[1]]);
+}
+
+static bool32 SGReconstructionSameContext(enum BattlerId battler)
+{
+    return SGReconstructionScope(battler)
+        && sSGReconstructionReceipt.resources == gBattleResources
+        && sSGReconstructionReceipt.turn == gBattleTurnCounter
+        && sSGReconstructionReceipt.playerParty == gBattlerPartyIndexes[0]
+        && sSGReconstructionReceipt.foeParty == gBattlerPartyIndexes[1];
+}
+
+bool32 SGReconstructionBeginFight(enum BattlerId battler)
+{
+    SGReconstructionResetReceipt(battler);
+    if (!SG_RECONSTRUCTION_AUTO_ENABLED || !SGReconstructionScope(battler))
+        return FALSE;
+    sSGReconstructionReceipt.resources = gBattleResources;
+    sSGReconstructionReceipt.turn = gBattleTurnCounter;
+    sSGReconstructionReceipt.playerParty = gBattlerPartyIndexes[0];
+    sSGReconstructionReceipt.foeParty = gBattlerPartyIndexes[1];
+    sSGReconstructionReceipt.phase = SG_RECEIPT_FIGHT;
+    return TRUE;
+}
