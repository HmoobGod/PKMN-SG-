+            money += GetTrainerMoneyToGive(TRAINER_BATTLE_PARAM.opponentB);
+
+        // Apply once to the combined native trainer award, not the shared
+        // moneyMultiplier used by Pay Day. Preserve native wallet saturation.
+        if (SG_RECONSTRUCTION_TRAINER_MONEY
+            && (gBattleTypeFlags & BATTLE_TYPE_TRAINER)
+            && !(gBattleTypeFlags & ~(BATTLE_TYPE_IS_MASTER | BATTLE_TYPE_TRAINER
+                                      | BATTLE_TYPE_DOUBLE | BATTLE_TYPE_TWO_OPPONENTS)))
+        {
+            u64 doubled = (u64)money * 2;
+            money = doubled > MAX_MONEY ? MAX_MONEY : (u32)doubled;
+        }
+        AddMoney(&gSaveBlock1Ptr->money, money);
     }
     else
     {
