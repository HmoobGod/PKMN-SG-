-        }
+        gSideTimers[side].lightscreenTimer = SG_RECONSTRUCTION_SCREEN_DURATION ? 8 : 5;
+
+        for (u32 i = 0; i < MAX_MON_ITEMS; i++)
+        {
+            if (GetSlotHeldItemEffect(battler, i, TRUE) == HOLD_EFFECT_LIGHT_CLAY)
+            {
+                if (SG_RECONSTRUCTION_SCREEN_DURATION)
+                    gSideTimers[side].lightscreenTimer = 12; // Multiple extenders do not stack in custom 8/12 mode.
+                else if (gSideTimers[side].lightscreenTimer == 5 || GetConfig(B_ALLOW_HELD_DUPES))
+                    gSideTimers[side].lightscreenTimer += 3;
