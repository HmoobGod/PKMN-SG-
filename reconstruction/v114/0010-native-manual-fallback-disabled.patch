+enum SGReconstructionFightResult SGReconstructionCheckFight(enum BattlerId battler)
+{
+    bool32 automatic = SG_RECONSTRUCTION_AUTO_ENABLED && battler == 0
+        && sSGReconstructionReceipt.phase == SG_RECEIPT_FIGHT;
+
+    /* Stale automatic provenance is not a human-selected Fight. Reject it
+     * before reading a restriction mask or committing native selection state. */
+    if (automatic && (!SGReconstructionSameContext(battler)
+        || (GetConfig(B_ENCORE_TARGET) < GEN_5 && gBattleMons[battler].volatiles.encoredMove != MOVE_NONE)))
+    {
+        SGReconstructionManualForTurn(battler);
+        return SG_FIGHT_RETURN_MANUAL;
+    }
+
+    // Exactly one natural restriction invocation for this Fight attempt.
+    u32 mask = CheckMoveLimitations(battler, 0, MOVE_LIMITATIONS_ALL);
+    if (automatic && (mask == ALL_MOVES_MASK || (mask & ~ALL_MOVES_MASK) != 0))
+    {
+        // Do not commit noValidMoves or the Struggle selection script.
+        SGReconstructionManualForTurn(battler);
+        return SG_FIGHT_RETURN_MANUAL;
+    }
+
+    bool32 allUnusable = SetFightNoMoves(battler, mask);
+    if (automatic)
+    {
+        sSGReconstructionReceipt.unusableMask = mask;
+        sSGReconstructionReceipt.phase = SG_RECEIPT_MASK;
+    }
+    else
+    {
+        SGReconstructionResetReceipt(battler);
+    }
+    return allUnusable ? SG_FIGHT_NO_MOVES : SG_FIGHT_CHOOSE_MOVE;
 }
 
