+void SGClearCustomTraps(enum BattlerId battler)
+{
+    if (!SGHasCustomTraps(battler))
+        return;
+    memset(gBattleStruct->sgTraps[battler], 0, sizeof(gBattleStruct->sgTraps[battler]));
+    SGSyncCustomTraps(battler);
+}
+
+bool32 SGStartCustomTrap(enum BattlerId battler, enum BattlerId setter, u16 move)
+{
+    if (gBattleStruct == NULL || battler >= gBattlersCount || setter >= gBattlersCount
+        || battler == setter || !IsBattlerAlive(battler) || !IsBattlerAlive(setter)
+        || (move != MOVE_FIRE_SPIN && move != MOVE_WHIRLPOOL))
+        return FALSE;
+    if (SGHasCustomTraps(battler) && !gBattleMons[battler].volatiles.wrapped)
+        SGClearCustomTraps(battler);
+    if (gBattleMons[battler].volatiles.wrapped && !SGHasCustomTraps(battler))
+        return FALSE; // Do not overwrite another native bind.
+
+    u32 slot = move == MOVE_FIRE_SPIN ? 0 : 1;
+    if (gBattleStruct->sgTraps[battler][slot].ticksPlusOne)
+        return FALSE; // Same-move non-refresh.
+    gBattleStruct->sgTraps[battler][slot].setter = setter;
+    gBattleStruct->sgTraps[battler][slot].ticksPlusOne =
+        BattlerHasHeldItemEffect(setter, HOLD_EFFECT_GRIP_CLAW, TRUE) ? 13 : 9;
+    SGSyncCustomTraps(battler);
+    return TRUE;
+}
+
+void SGTrapBattlerLeaves(enum BattlerId battler)
+{
+    SGClearCustomTraps(battler);
+    for (enum BattlerId target = 0; target < gBattlersCount; target++)
+    {
+        if (!SGHasCustomTraps(target))
+            continue;
+        if (!gBattleMons[target].volatiles.wrapped)
+        {
+            SGClearCustomTraps(target);
+            continue;
+        }
+        for (u32 slot = 0; slot < 2; slot++)
+            if (gBattleStruct->sgTraps[target][slot].ticksPlusOne
+                && gBattleStruct->sgTraps[target][slot].setter == battler)
+                gBattleStruct->sgTraps[target][slot].ticksPlusOne = 0;
+        SGSyncCustomTraps(target);
+    }
+}
+#endif
