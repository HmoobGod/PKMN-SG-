+    enum Item item;
+    enum Type types[3];
+    u32 tauntTimer;
+    u32 disableTimer;
+    u32 encoreTimer;
+    u32 tormentTimer;
+    u16 foeSpecies;
+    u16 foeHp;
+    u32 foeStatus1;
+    enum Ability foeAbility;
+} sSourceFirstWildLease;
