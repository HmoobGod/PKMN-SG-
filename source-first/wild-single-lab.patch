+/* A single-use source-LAB staging token. The actual modified-ROM engine
+ * still needs independent per-request CPU/ownership certification. */
+static struct
+{
+    bool32 armed;
+    enum BattlerId owner;
+    enum BattlerId foe;
+    u16 moves[MAX_MON_MOVES];
+    u8 pp[MAX_MON_MOVES];
+    u8 partyIndex;
+    u8 proposedSlot;
+    u16 species;
+    u16 hp;
+    u32 status1;
+    /* Read the original engine's turn; an abandoned two-stage request must
+     * never be reused after the turn changes. This is not an engine epoch. */
+    u16 turnCounter;
+    u8 foePartyIndex;
+    enum Type foeTypes[3];
+    /* The original request can straddle volatile rule/held-item changes.
+     * Read them only; never try to repair opponent or player state. */
+    enum Ability ability;
+    enum Ability innates[MAX_MON_INNATES_INTERNAL];
+    enum Item items[MAX_MON_ITEMS_INTERNAL];
+    enum Item item;
+    enum Type types[3];
+    u32 tauntTimer;
+    u32 disableTimer;
+    u32 encoreTimer;
+    u32 tormentTimer;
+    u16 foeSpecies;
+    u16 foeHp;
+    u32 foeStatus1;
+    enum Ability foeAbility;
+    /* Both original selection stages must retain the opponent's remaining
+     * target-affecting state; neither stage may modify foe AI/actions. */
+    enum Item foeItem;
+    enum Item foeItems[MAX_MON_ITEMS_INTERNAL];
+    enum Ability foeInnates[MAX_MON_INNATES_INTERNAL];
+    u32 foeTauntTimer;
+    u32 foeDisableTimer;
+    u32 foeEncoreTimer;
+    u32 foeTormentTimer;
+} sSourceFirstWildLease;
+
+static void SourceFirstInvalidateWildLease(void)
+{
+    /* Cancel staged automation without touching engine/guest ownership. */
+    sSourceFirstWildLease.armed = FALSE;
+}
+
+static void SourceFirstArmWildLease(enum BattlerId battler)
+{
+    u32 slot;
+    sSourceFirstWildLease.owner = battler;
+    sSourceFirstWildLease.foe = GetBattlerAtPosition(B_POSITION_OPPONENT_LEFT);
+    sSourceFirstWildLease.partyIndex = gBattlerPartyIndexes[battler];
+    sSourceFirstWildLease.species = gBattleMons[battler].species;
+    sSourceFirstWildLease.hp = gBattleMons[battler].hp;
+    sSourceFirstWildLease.status1 = gBattleMons[battler].status1;
+    sSourceFirstWildLease.turnCounter = gBattleTurnCounter;
+    sSourceFirstWildLease.foePartyIndex = gBattlerPartyIndexes[sSourceFirstWildLease.foe];
+    sSourceFirstWildLease.ability = gBattleMons[battler].ability;
+    sSourceFirstWildLease.item = gBattleMons[battler].item;
+    sSourceFirstWildLease.tauntTimer = gBattleMons[battler].volatiles.tauntTimer;
+    sSourceFirstWildLease.disableTimer = gBattleMons[battler].volatiles.disableTimer;
+    sSourceFirstWildLease.encoreTimer = gBattleMons[battler].volatiles.encoreTimer;
+    sSourceFirstWildLease.tormentTimer = gBattleMons[battler].volatiles.tormentTimer;
+    sSourceFirstWildLease.foeSpecies = gBattleMons[sSourceFirstWildLease.foe].species;
+    sSourceFirstWildLease.foeHp = gBattleMons[sSourceFirstWildLease.foe].hp;
+    sSourceFirstWildLease.foeStatus1 = gBattleMons[sSourceFirstWildLease.foe].status1;
+    sSourceFirstWildLease.foeAbility = gBattleMons[sSourceFirstWildLease.foe].ability;
+    sSourceFirstWildLease.foeItem = gBattleMons[sSourceFirstWildLease.foe].item;
+    sSourceFirstWildLease.foeTauntTimer = gBattleMons[sSourceFirstWildLease.foe].volatiles.tauntTimer;
+    sSourceFirstWildLease.foeDisableTimer = gBattleMons[sSourceFirstWildLease.foe].volatiles.disableTimer;
+    sSourceFirstWildLease.foeEncoreTimer = gBattleMons[sSourceFirstWildLease.foe].volatiles.encoreTimer;
+    sSourceFirstWildLease.foeTormentTimer = gBattleMons[sSourceFirstWildLease.foe].volatiles.tormentTimer;
+    for (slot = 0; slot < MAX_MON_ITEMS_INTERNAL; slot++)
+        sSourceFirstWildLease.items[slot] = gBattleMons[battler].items[slot];
+    for (slot = 0; slot < MAX_MON_INNATES_INTERNAL; slot++)
+        sSourceFirstWildLease.innates[slot] = gBattleMons[battler].innates[slot];
+    for (slot = 0; slot < MAX_MON_ITEMS_INTERNAL; slot++)
+        sSourceFirstWildLease.foeItems[slot] = gBattleMons[sSourceFirstWildLease.foe].items[slot];
+    for (slot = 0; slot < MAX_MON_INNATES_INTERNAL; slot++)
+        sSourceFirstWildLease.foeInnates[slot] = gBattleMons[sSourceFirstWildLease.foe].innates[slot];
+    for (slot = 0; slot < 3; slot++)
+    {
+        sSourceFirstWildLease.types[slot] = gBattleMons[battler].types[slot];
+        sSourceFirstWildLease.foeTypes[slot] = gBattleMons[sSourceFirstWildLease.foe].types[slot];
+    }
+    for (slot = 0; slot < MAX_MON_MOVES; slot++)
+    {
+        sSourceFirstWildLease.moves[slot] = gBattleMons[battler].moves[slot];
+        sSourceFirstWildLease.pp[slot] = gBattleMons[battler].pp[slot];
+    }
+    sSourceFirstWildLease.armed = TRUE;
+}
