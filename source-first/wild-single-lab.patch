+/* SOURCE-FIRST LAB ONLY: this code is applied to a disposable upstream checkout.
+ * It is not installed in the protected Current ROM or existing save. */
+static bool32 SourceFirstWildSingleOwner(enum BattlerId battler)
+{
+    enum BattlerId foe;
+
+    /* BATTLE_TYPE_IS_MASTER is set in normal non-link battles. Reject all
+     * other battle modes, including trainers, doubles, Palace, partners,
+     * safari, link, roaming, special/legendary and recorded encounters. */
+    if (gBattleTypeFlags != BATTLE_TYPE_IS_MASTER)
+        return FALSE;
+    if (gBattlersCount != 2 || battler != 0 || battler >= gBattlersCount)
+        return FALSE;
+    if (gBattlerBattleController[battler] != BATTLE_CONTROLLER_PLAYER)
+        return FALSE;
+    if (GetBattlerPosition(battler) != B_POSITION_PLAYER_LEFT)
+        return FALSE;
+
+    foe = GetBattlerAtPosition(B_POSITION_OPPONENT_LEFT);
+    if (foe >= gBattlersCount || foe == battler ||
+        GetBattlerPosition(foe) != B_POSITION_OPPONENT_LEFT || IsBattlerAlly(battler, foe))
+        return FALSE;
+    if (gAbsentBattlerFlags & ((1u << battler) | (1u << foe)))
+        return FALSE;
+    if (!IsBattlerAlive(battler) || !IsBattlerAlive(foe))
+        return FALSE;
+    return TRUE;
+}
+
+/* Conservative baseline selector, not Smart AI scoring. No enemy AI state,
+ * battle RNG, bag, capture, partner or target reassignment is touched.
+ * Zero eligible moves => NO auto reply; engine's normal input path remains. */
+static bool32 SourceFirstWildSingleMove(enum BattlerId battler, bool32 verifyReply, u32 *reply)
+{
+    u32 unusable;
+    u32 slot;
+    enum BattlerId foe;
+    struct ChooseMoveStruct *moveInfo = NULL;
+
+    if (!SourceFirstWildSingleOwner(battler))
+        return FALSE;
+
+    /* The original command byte is a required, read-only request witness. */
+    if (gBattleResources == NULL ||
+        gBattleResources->bufferA[battler][0] !=
+        (verifyReply ? CONTROLLER_CHOOSEMOVE : CONTROLLER_CHOOSEACTION))
+        return FALSE;
+
+    foe = GetBattlerAtPosition(B_POSITION_OPPONENT_LEFT);
+    if (verifyReply)
+        moveInfo = (struct ChooseMoveStruct *)&gBattleResources->bufferA[battler][4];
+    unusable = verifyReply ? CheckMoveLimitations(battler, 0, MOVE_LIMITATIONS_ALL) : 0;
+    for (slot = 0; slot < MAX_MON_MOVES; slot++)
+    {
+        enum Move move = gBattleMons[battler].moves[slot];
+
+        if ((unusable & (1u << slot)) || move == MOVE_NONE || gBattleMons[battler].pp[slot] == 0)
+            continue;
+        if (GetBattlerMoveTargetType(battler, move) != TARGET_SELECTED ||
+            !CanTargetBattler(battler, foe, move))
+            continue;
+        if (verifyReply && (moveInfo->moves[slot] != move ||
+                           moveInfo->currentPp[slot] != gBattleMons[battler].pp[slot]))
+            continue;
+        if (verifyReply)
+            *reply = slot | (foe << 8); // Normal, non-gimmick move+target reply.
+        return TRUE;
+    }
+    return FALSE;
+}
