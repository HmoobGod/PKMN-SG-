+/* Pure read-only revalidation, including original engine ownership and all
+ * staged player/opponent states. This helper deliberately does NOT require the
+ * lease to remain armed: Consume destroys the token before invoking any
+ * original move limitation or target helper with potential side effects. */
+static bool32 SourceFirstWildLeaseSnapshotMatches(enum BattlerId battler)
+{
+    u32 slot;
+    if (!SourceFirstWildSingleOwner(battler) ||
+        gBattlerPartyIndexes[battler] != sSourceFirstWildLease.partyIndex ||
+        sSourceFirstWildLease.proposedSlot >= MAX_MON_MOVES ||
+        gBattleMons[battler].species != sSourceFirstWildLease.species ||
+        gBattleMons[battler].hp != sSourceFirstWildLease.hp ||
+        gBattleMons[battler].status1 != sSourceFirstWildLease.status1 ||
+        gBattleTurnCounter != sSourceFirstWildLease.turnCounter ||
+        gBattlerPartyIndexes[sSourceFirstWildLease.foe] != sSourceFirstWildLease.foePartyIndex ||
+        gBattleMons[battler].ability != sSourceFirstWildLease.ability ||
+        gBattleMons[battler].item != sSourceFirstWildLease.item ||
+        gBattleMons[battler].volatiles.tauntTimer != sSourceFirstWildLease.tauntTimer ||
+        gBattleMons[battler].volatiles.disableTimer != sSourceFirstWildLease.disableTimer ||
+        gBattleMons[battler].volatiles.encoreTimer != sSourceFirstWildLease.encoreTimer ||
+        gBattleMons[battler].volatiles.tormentTimer != sSourceFirstWildLease.tormentTimer ||
+        GetBattlerAtPosition(B_POSITION_OPPONENT_LEFT) != sSourceFirstWildLease.foe ||
+        gBattleMons[sSourceFirstWildLease.foe].species != sSourceFirstWildLease.foeSpecies ||
+        gBattleMons[sSourceFirstWildLease.foe].hp != sSourceFirstWildLease.foeHp ||
+        gBattleMons[sSourceFirstWildLease.foe].status1 != sSourceFirstWildLease.foeStatus1 ||
+        gBattleMons[sSourceFirstWildLease.foe].ability != sSourceFirstWildLease.foeAbility)
+        return FALSE;
+    if (gBattleMons[sSourceFirstWildLease.foe].item != sSourceFirstWildLease.foeItem ||
+        gBattleMons[sSourceFirstWildLease.foe].volatiles.tauntTimer != sSourceFirstWildLease.foeTauntTimer ||
+        gBattleMons[sSourceFirstWildLease.foe].volatiles.disableTimer != sSourceFirstWildLease.foeDisableTimer ||
+        gBattleMons[sSourceFirstWildLease.foe].volatiles.encoreTimer != sSourceFirstWildLease.foeEncoreTimer ||
+        gBattleMons[sSourceFirstWildLease.foe].volatiles.tormentTimer != sSourceFirstWildLease.foeTormentTimer)
+        return FALSE;
+    for (slot = 0; slot < MAX_MON_ITEMS_INTERNAL; slot++)
+    {
+        if (sSourceFirstWildLease.foeItems[slot] !=
+            gBattleMons[sSourceFirstWildLease.foe].items[slot])
+            return FALSE;
+    }
+    for (slot = 0; slot < MAX_MON_INNATES_INTERNAL; slot++)
+    {
+        if (sSourceFirstWildLease.foeInnates[slot] !=
+            gBattleMons[sSourceFirstWildLease.foe].innates[slot])
+            return FALSE;
+    }
+    for (slot = 0; slot < MAX_MON_ITEMS_INTERNAL; slot++)
+    {
+        if (sSourceFirstWildLease.items[slot] != gBattleMons[battler].items[slot])
+            return FALSE;
+    }
+    for (slot = 0; slot < MAX_MON_INNATES_INTERNAL; slot++)
+    {
+        if (sSourceFirstWildLease.innates[slot] != gBattleMons[battler].innates[slot])
+            return FALSE;
+    }
+    for (slot = 0; slot < 3; slot++)
+    {
+        if (sSourceFirstWildLease.types[slot] != gBattleMons[battler].types[slot] ||
+            sSourceFirstWildLease.foeTypes[slot] != gBattleMons[sSourceFirstWildLease.foe].types[slot])
+            return FALSE;
+    }
+    for (slot = 0; slot < MAX_MON_MOVES; slot++)
+    {
+        if (sSourceFirstWildLease.moves[slot] != gBattleMons[battler].moves[slot] ||
+            sSourceFirstWildLease.pp[slot] != gBattleMons[battler].pp[slot])
+            return FALSE;
+    }
+    return TRUE;
+}
