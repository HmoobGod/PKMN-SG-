+/* Conservative baseline selector, not Smart AI scoring. No enemy AI state,
+ * battle RNG, bag, capture, partner or target reassignment is touched.
+ * Zero eligible moves => NO auto reply; engine's normal input path remains. */
+static bool32 SourceFirstWildSingleMove(enum BattlerId battler, bool32 verifyReply, u32 *reply)
+{
+    u32 unusable;
+    u32 slot;
+    u32 poolSlot;
+    u16 preTargetMoves[MAX_MON_MOVES];
+    u8 preTargetPP[MAX_MON_MOVES];
+    enum BattlerId foe;
+    struct ChooseMoveStruct *moveInfo = NULL;
+
+    if (!SourceFirstWildSingleOwner(battler))
+        return FALSE;
+
+    /* The original command byte is a required, read-only request witness. */
+    if (gBattleResources == NULL ||
+        gBattleResources->bufferA[battler][0] !=
+        (verifyReply ? CONTROLLER_CHOOSEMOVE : CONTROLLER_CHOOSEACTION))
+        return FALSE;
+
+    foe = GetBattlerAtPosition(B_POSITION_OPPONENT_LEFT);
+    if (verifyReply)
+        moveInfo = (struct ChooseMoveStruct *)&gBattleResources->bufferA[battler][4];
+    unusable = verifyReply ? CheckMoveLimitations(battler, 0, MOVE_LIMITATIONS_ALL) : 0;
+    /* Restrictions may trigger engine side effects. Recheck ownership and
+     * command after that call, before producing any automatic reply. */
+    if (verifyReply && (!SourceFirstWildSingleOwner(battler) ||
+        gBattleTurnCounter != sSourceFirstWildLease.turnCounter ||
+        !SourceFirstWildLeaseSnapshotMatches(battler) ||
+        gBattleResources == NULL ||
+        !(gBattleResources->bufferA[battler][0] == CONTROLLER_CHOOSEMOVE)))
+        return FALSE;
+    /* One identity baseline per original proposal, BEFORE any candidate
+     * slot can run a potentially stateful targeting helper. */
+    u16 preTargetTurn = gBattleTurnCounter;
+    u8 preTargetPlayerParty = gBattlerPartyIndexes[battler];
+    u8 preTargetFoeParty = gBattlerPartyIndexes[foe];
+    /* The player may also be mutated by a target helper BEFORE the staging
+     * lease is armed. Do not freeze a post-mutation player as the baseline. */
+    u16 preTargetPlayerSpecies = gBattleMons[battler].species;
+    u16 preTargetPlayerHp = gBattleMons[battler].hp;
+    u32 preTargetPlayerStatus1 = gBattleMons[battler].status1;
+    enum Ability preTargetPlayerAbility = gBattleMons[battler].ability;
+    enum Item preTargetPlayerItem = gBattleMons[battler].item;
+    u32 preTargetTaunt = gBattleMons[battler].volatiles.tauntTimer;
+    u32 preTargetDisable = gBattleMons[battler].volatiles.disableTimer;
+    u32 preTargetEncore = gBattleMons[battler].volatiles.encoreTimer;
+    u32 preTargetTorment = gBattleMons[battler].volatiles.tormentTimer;
+    enum Type preTargetPlayerTypes[3];
+    enum Ability preTargetPlayerInnates[MAX_MON_INNATES_INTERNAL];
+    enum Item preTargetPlayerItems[MAX_MON_ITEMS_INTERNAL];
+    for (poolSlot = 0; poolSlot < 3; poolSlot++)
+        preTargetPlayerTypes[poolSlot] = gBattleMons[battler].types[poolSlot];
+    for (poolSlot = 0; poolSlot < MAX_MON_INNATES_INTERNAL; poolSlot++)
+        preTargetPlayerInnates[poolSlot] = gBattleMons[battler].innates[poolSlot];
+    for (poolSlot = 0; poolSlot < MAX_MON_ITEMS_INTERNAL; poolSlot++)
+        preTargetPlayerItems[poolSlot] = gBattleMons[battler].items[poolSlot];
+    /* Freeze foe combat identity BEFORE any possibly stateful target helper. */
+    u16 preTargetFoeSpecies = gBattleMons[foe].species;
+    u16 preTargetFoeHp = gBattleMons[foe].hp;
+    u32 preTargetFoeStatus1 = gBattleMons[foe].status1;
+    enum Ability preTargetFoeAbility = gBattleMons[foe].ability;
+    enum Type preTargetFoeTypes[3];
+    for (poolSlot = 0; poolSlot < 3; poolSlot++)
+        preTargetFoeTypes[poolSlot] = gBattleMons[foe].types[poolSlot];
+
+    /* Freeze foe item, passive abilities and volatile target rules BEFORE
+     * any target helper. A later helper must not re-baseline these fields. */
+    enum Item preTargetFoeItem = gBattleMons[foe].item;
+    u32 preTargetFoeTaunt = gBattleMons[foe].volatiles.tauntTimer;
+    u32 preTargetFoeDisable = gBattleMons[foe].volatiles.disableTimer;
+    u32 preTargetFoeEncore = gBattleMons[foe].volatiles.encoreTimer;
+    u32 preTargetFoeTorment = gBattleMons[foe].volatiles.tormentTimer;
+    enum Item preTargetFoeItems[MAX_MON_ITEMS_INTERNAL];
+    enum Ability preTargetFoeInnates[MAX_MON_INNATES_INTERNAL];
+    for (poolSlot = 0; poolSlot < MAX_MON_ITEMS_INTERNAL; poolSlot++)
+        preTargetFoeItems[poolSlot] = gBattleMons[foe].items[poolSlot];
+    for (poolSlot = 0; poolSlot < MAX_MON_INNATES_INTERNAL; poolSlot++)
+        preTargetFoeInnates[poolSlot] = gBattleMons[foe].innates[poolSlot];
+
+    /* Freeze all player-owned moves and PP once BEFORE any candidate helper.
+     * Do not silently select a later slot from a mutated live move pool. */
+    if (!verifyReply)
+    {
+        for (poolSlot = 0; poolSlot < MAX_MON_MOVES; poolSlot++)
+        {
+            preTargetMoves[poolSlot] = gBattleMons[battler].moves[poolSlot];
+            preTargetPP[poolSlot] = gBattleMons[battler].pp[poolSlot];
+        }
+    }
+
+    for (slot = 0; slot < MAX_MON_MOVES; slot++)
+    {
+        enum Move move = gBattleMons[battler].moves[slot];
+        bool32 canTarget;
+
+        /* Keep the one proposed slot for this two-stage request. If it
+         * becomes disabled/Choiced/Encored/Imprisoned or otherwise illegal,
+         * never silently switch the automatic move; fall back to manual. */
+        if (verifyReply && slot != sSourceFirstWildLease.proposedSlot)
+            continue;
+        /* Engine-required Struggle is a distinct unapproved path. Do not
+         * proactively select it, even if a custom moveset exposes it. */
+        if ((unusable & (1u << slot)) || move == MOVE_NONE || move == MOVE_STRUGGLE ||
+            gBattleMons[battler].pp[slot] == 0)
+            continue;
+        canTarget = !(GetBattlerMoveTargetType(battler, move) != TARGET_SELECTED ||
+                      !CanTargetBattler(battler, foe, move));
+        /* A targeting helper may mutate an EARLIER or LATER move/PP slot.
+         * Reject the whole auto proposal even when this slot is ineligible. */
+        if (!verifyReply)
+        {
+            for (poolSlot = 0; poolSlot < MAX_MON_MOVES; poolSlot++)
+            {
+                if (gBattleMons[battler].moves[poolSlot] != preTargetMoves[poolSlot] ||
+                    gBattleMons[battler].pp[poolSlot] != preTargetPP[poolSlot])
+                    return FALSE;
+            }
+        }
+        /* First-stage player volatility/ability/item changes are just as
+         * dangerous as foe changes: a fresh lease after the mutation would
+         * silently launder a stale automatic proposal. Fail before skip. */
+        if (!verifyReply)
+        {
+            if (gBattleMons[battler].species != preTargetPlayerSpecies ||
+                gBattleMons[battler].hp != preTargetPlayerHp ||
+                gBattleMons[battler].status1 != preTargetPlayerStatus1 ||
+                gBattleMons[battler].ability != preTargetPlayerAbility ||
+                gBattleMons[battler].item != preTargetPlayerItem ||
+                gBattleMons[battler].volatiles.tauntTimer != preTargetTaunt ||
+                gBattleMons[battler].volatiles.disableTimer != preTargetDisable ||
+                gBattleMons[battler].volatiles.encoreTimer != preTargetEncore ||
+                gBattleMons[battler].volatiles.tormentTimer != preTargetTorment)
+                return FALSE;
+            for (poolSlot = 0; poolSlot < 3; poolSlot++)
+            {
+                if (gBattleMons[battler].types[poolSlot] != preTargetPlayerTypes[poolSlot])
+                    return FALSE;
+            }
+            for (poolSlot = 0; poolSlot < MAX_MON_INNATES_INTERNAL; poolSlot++)
+            {
+                if (gBattleMons[battler].innates[poolSlot] != preTargetPlayerInnates[poolSlot])
+                    return FALSE;
+            }
+            for (poolSlot = 0; poolSlot < MAX_MON_ITEMS_INTERNAL; poolSlot++)
+            {
+                if (gBattleMons[battler].items[poolSlot] != preTargetPlayerItems[poolSlot])
+                    return FALSE;
+            }
+        }
+        /* A target helper can alter species, HP, ability, status or typing
+         * before the staging token is armed. Reject even an ineligible
+         * candidate rather than selecting another move using altered foe. */
+        if (!verifyReply)
+        {
+            if (gBattleMons[foe].species != preTargetFoeSpecies ||
+                gBattleMons[foe].hp != preTargetFoeHp ||
+                gBattleMons[foe].status1 != preTargetFoeStatus1 ||
+                gBattleMons[foe].ability != preTargetFoeAbility)
+                return FALSE;
+            for (poolSlot = 0; poolSlot < 3; poolSlot++)
+            {
+                if (gBattleMons[foe].types[poolSlot] != preTargetFoeTypes[poolSlot])
+                    return FALSE;
+            }
+        }
+        /* Reject foe-held items, passive abilities and volatile timers
+         * changed by either targeting helper before skipping this slot or
+         * arming a new lease. The foe's actions are never modified here. */
+        if (!verifyReply)
+        {
+            if (gBattleMons[foe].item != preTargetFoeItem ||
+                gBattleMons[foe].volatiles.tauntTimer != preTargetFoeTaunt ||
+                gBattleMons[foe].volatiles.disableTimer != preTargetFoeDisable ||
+                gBattleMons[foe].volatiles.encoreTimer != preTargetFoeEncore ||
+                gBattleMons[foe].volatiles.tormentTimer != preTargetFoeTorment)
+                return FALSE;
+            for (poolSlot = 0; poolSlot < MAX_MON_ITEMS_INTERNAL; poolSlot++)
+            {
+                if (gBattleMons[foe].items[poolSlot] != preTargetFoeItems[poolSlot])
+                    return FALSE;
+            }
+            for (poolSlot = 0; poolSlot < MAX_MON_INNATES_INTERNAL; poolSlot++)
+            {
+                if (gBattleMons[foe].innates[poolSlot] != preTargetFoeInnates[poolSlot])
+                    return FALSE;
+            }
+        }
+        /* Source-LAB action proposal: targeting helpers must not silently
+         * change the original player0 ChooseAction request, selected move,
+         * PP, foe or active owner before Fight is submitted. */
+        if (!verifyReply && (!SourceFirstWildSingleOwner(battler) ||
+            gBattleTurnCounter != preTargetTurn ||
+            gBattlerPartyIndexes[battler] != preTargetPlayerParty ||
+            gBattlerPartyIndexes[foe] != preTargetFoeParty ||
+            gBattleResources == NULL ||
+            gBattleResources->bufferA[battler][0] != CONTROLLER_CHOOSEACTION ||
+            GetBattlerAtPosition(B_POSITION_OPPONENT_LEFT) != foe ||
+            gBattleMons[battler].moves[slot] != move ||
+            gBattleMons[battler].pp[slot] == 0))
+            return FALSE;
+        /* Reject drift even when a helper marks this candidate ineligible.
+         * Otherwise the next slot would run on a stale ChooseAction request. */
+        if (!canTarget)
+            continue;
+        /* Original targeting helpers may change the live player command or
+         * replace the engine's ChooseMove request buffer. Before dereferencing
+         * its earlier pointer, require that the same original buffer and
+         * command still belong to the live player0 request. A stale buffer
+         * must never be used to authorize a new automatic reply. */
+        if (verifyReply && (gBattleResources == NULL ||
+            gBattleResources->bufferA[battler][0] != CONTROLLER_CHOOSEMOVE ||
+            moveInfo != (struct ChooseMoveStruct *)&gBattleResources->bufferA[battler][4]))
+            return FALSE;
+        if (verifyReply && (moveInfo->moves[slot] != move ||
+                           moveInfo->currentPp[slot] != gBattleMons[battler].pp[slot]))
+            continue;
